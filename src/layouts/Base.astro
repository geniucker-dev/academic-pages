---
import { getEntry } from 'astro:content';
import '../styles/home.css';
const entry = await getEntry('profile', 'haoyu');
if (!entry) throw new Error('Missing profile: src/content/profile/haoyu.md');
const profile = entry.data;
interface Props { title?: string }
const title = Astro.props.title ? `${Astro.props.title} — ${profile.name}` : `${profile.name} (${profile.nativeName})`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const updated = new Date(`${profile.updated}T00:00:00Z`);
const updateLabel = updated.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={profile.description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={profile.description} />
    <meta property="og:image" content={new URL(profile.avatar, Astro.site)} />
    <meta property="og:image:alt" content={`${profile.name} (${profile.nativeName})`} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <nav class="nav" aria-label="Main navigation">
      <a class="nav__name" href="/">{profile.name}</a>
      <div class="nav__links">
        <a href="/#publications">Publications</a>
        <a href="/#experience">Experience</a>
        <a href="/cv/" aria-current={Astro.url.pathname === '/cv/' ? 'page' : undefined}>CV</a>
      </div>
    </nav>
    <main class="container" id="main"><slot /></main>
    <footer class="container">
      <div class="footer"><span>&copy; {updated.getUTCFullYear()} {profile.name}</span><span>Updated {updateLabel}</span></div>
    </footer>
  </body>
</html>
