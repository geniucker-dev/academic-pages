---
export function getStaticPaths() {
  const redirects = {
    'about': '/',
    'publications': '/#publications',
    'education': '/#education',
    'teaching': '/#teaching',
    'resume': '/cv/',
    'publication/2025-11-25-t-skm-net': '/#publications',
  };
  return Object.entries(redirects).map(([redirect, target]) => ({ params: { redirect }, props: { target } }));
}
const { target } = Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta http-equiv="refresh" content={`0;url=${target}`} /><meta name="robots" content="noindex" /><link rel="canonical" href={new URL(target, Astro.site)} /><title>Haoyu Zhu — Page moved</title></head><body><p>This page has moved. <a href={target}>Continue to Haoyu Zhu's website</a>.</p></body></html>
